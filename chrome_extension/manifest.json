{
  "manifest_version": 3,
  "name": "El Al Bonus Sync -> Family Vacation Planner",
  "version": "1.3.0",
  "description": "Scans El Al rbddataclients holiday dates (Economy & Premium) and syncs them to your Family Vacation Planner server (family-trip-planner.duckdns.org).",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.elal.com/*",
    "https://family-trip-planner.duckdns.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.elal.com/rbddataclients*"],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.elal.com/rbddataclients*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}

{
  "manifest_version": 3,
  "name": "El Al Bonus Sync -> Family Vacation Planner",
  "version": "2.2.0",
  "description": "Safely scans El Al rbddataclients (Full Year default, Holidays, or Specific Date) across all supported destinations and syncs to breezyflights.com.",
  "permissions": ["storage"],
  "host_permissions": [
    "https://www.elal.com/*",
    "https://breezyflights.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.elal.com/rbddataclients*"],
      "js": ["content.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.elal.com/rbddataclients*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
